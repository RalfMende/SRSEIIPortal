#!/bin/sh
set -eu

SCRIPT_NAME="$(basename "$0")"

# Shared with the status/update CGI scripts so package-installed lookups avoid one opkg spawn per package per request.
OPKG_STATUS_CACHE_FILE="/tmp/srseii-opkg-status-cache"
OPKG_STATUS_CACHE_TTL=60

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

usage() {
	cat <<EOF
Usage: $SCRIPT_NAME <mswebapp|railcontrol|z21interface|cs2interface|itrain|windigipet|rocrail|all>

Checks each relevant package and service for a model railway use case,
installs missing packages with opkg, then enables and starts the service
so it is also active on boot.
EOF
}

refresh_opkg_status_cache() {
	if [ -f "$OPKG_STATUS_CACHE_FILE" ]; then
		cache_mtime="$(stat -c '%Y' "$OPKG_STATUS_CACHE_FILE" 2>/dev/null || echo 0)"
		now_epoch="$(date +%s 2>/dev/null || echo 0)"
		cache_age=$((now_epoch - cache_mtime))
		if [ "$cache_age" -ge 0 ] && [ "$cache_age" -lt "$OPKG_STATUS_CACHE_TTL" ]; then
			return 0
		fi
	fi

	opkg status > "${OPKG_STATUS_CACHE_FILE}.tmp" 2>/dev/null && mv "${OPKG_STATUS_CACHE_FILE}.tmp" "$OPKG_STATUS_CACHE_FILE"
}

pkg_is_installed() {
	package_name="$1"
	if ! command -v opkg >/dev/null 2>&1; then
		return 1
	fi

	refresh_opkg_status_cache
	if [ -f "$OPKG_STATUS_CACHE_FILE" ]; then
		if awk -v pkg="$package_name" '
			BEGIN { RS = ""; FS = "\n" }
			{
				matched = 0
				for (i = 1; i <= NF; i++) {
					if ($i == "Package: " pkg) { matched = 1 }
				}
				if (matched) {
					for (i = 1; i <= NF; i++) {
						if ($i ~ /^Status:/) { print $i }
					}
				}
			}
		' "$OPKG_STATUS_CACHE_FILE" 2>/dev/null | grep -q '^Status: .* installed$'; then
			return 0
		fi
		return 1
	fi

	# Cache could not be created (e.g. read-only /tmp); fall back to a direct query.
	if opkg status "$package_name" 2>/dev/null | grep -q '^Status: .* installed$'; then
		return 0
	fi
	return 1
}

service_is_running() {
	service_name="$1"

	if command -v pidof >/dev/null 2>&1 && pidof "$service_name" >/dev/null 2>&1; then
		return 0
	fi

	if command -v pgrep >/dev/null 2>&1 && pgrep -f "$service_name" >/dev/null 2>&1; then
		return 0
	fi

	# Legacy rc.common scripts (start()/stop() without procd) do not implement
	# "running"/"status" and print a usage text instead. That usage text contains
	# words like "Start", which a loose grep would misread as "running". Only an
	# explicit "running" report counts; usage output must never match.
	if [ -x "/etc/init.d/$service_name" ]; then
		status_output="$("/etc/init.d/$service_name" status 2>/dev/null || true)"
		case "$status_output" in
			*Syntax:*|*"Available commands"*)
				;;
			*)
				if printf '%s' "$status_output" | grep -Eiq '\brunning\b'; then
					return 0
				fi
				;;
		esac
	fi

	return 1
}

install_package() {
	package_name="$1"
	if pkg_is_installed "$package_name"; then
		echo "Package already installed: $package_name"
		return 0
	fi

	echo "Installing package: $package_name"
	if ! opkg install "$package_name"; then
		echo "Failed to install $package_name" >&2
		return 1
	fi

	# Package set on disk changed; force the next lookup to see the fresh state.
	rm -f "$OPKG_STATUS_CACHE_FILE"

	return 0
}

ensure_service_started() {
	service_name="$1"

	if [ -x "/etc/init.d/$service_name" ]; then
		echo "Ensuring service is enabled and started: $service_name"
		/etc/init.d/"$service_name" enable >/dev/null 2>&1 || true
		/etc/init.d/"$service_name" start >/dev/null 2>&1 || true
		return 0
	fi

	if command -v service >/dev/null 2>&1; then
		echo "Ensuring system service is enabled and started: $service_name"
		service "$service_name" enable >/dev/null 2>&1 || true
		service "$service_name" start >/dev/null 2>&1 || true
		return 0
	fi

	echo "Service script not found for $service_name; skipping startup step." >&2
	return 1
}

ensure_service_stopped() {
	service_name="$1"

	if [ -x "/etc/init.d/$service_name" ]; then
		echo "Ensuring service is disabled and stopped: $service_name"
		/etc/init.d/"$service_name" disable >/dev/null 2>&1 || true
		/etc/init.d/"$service_name" stop >/dev/null 2>&1 || true
		return 0
	fi

	if command -v service >/dev/null 2>&1; then
		echo "Ensuring system service is disabled and stopped: $service_name"
		service "$service_name" disable >/dev/null 2>&1 || true
		service "$service_name" stop >/dev/null 2>&1 || true
		return 0
	fi

	echo "Service script not found for $service_name; skipping stop step." >&2
	return 1
}

get_usecase_pkgs() {
	usecase_name="$1"

	case "$usecase_name" in
		mswebapp)
			printf '%s\n' "can2udp" "mswebapp"
			;;
		railcontrol)
			printf '%s\n' "can2udp" "railcontrol"
			;;
		z21interface)
			printf '%s\n' "can2udp" "z21emu"
			;;
		cs2interface)
			printf '%s\n' "can2udp"
			;;
		itrain)
			printf '%s\n' "can2udp"
			;;
		windigipet)
			printf '%s\n' "can2udp"
			;;
		rocrail)
			printf '%s\n' "can2udp" "rocrail"
			;;
		*)
			echo "Unknown use case: $usecase_name" >&2
			return 1
			;;
	esac
}

get_usecase_services() {
	usecase_name="$1"

	case "$usecase_name" in
		mswebapp)
			printf '%s\n' "can2lan" "clone-ms2-loco" "mswebapp"
			;;
		railcontrol)
			printf '%s\n' "can2lan" "clone-ms2-loco" "railcontrol"
			;;
		z21interface)
			printf '%s\n' "can2lan" "z21emu"
			;;
		cs2interface)
			printf '%s\n' "can2lan"
			;;
		itrain)
			printf '%s\n' "can2lan"
			;;
		windigipet)
			printf '%s\n' "can2lan"
			;;
		rocrail)
			printf '%s\n' "can2lan" "rocrail"
			;;
		*)
			echo "Unknown use case: $usecase_name" >&2
			return 1
			;;
	esac
}

get_usecase_forbidden_services() {
	usecase_name="$1"

	case "$usecase_name" in
		mswebapp|railcontrol)
			printf '%s\n' "ms2-loco-list"
			;;
		z21interface|cs2interface|itrain|windigipet|rocrail)
			;;
		*)
			echo "Unknown use case: $usecase_name" >&2
			return 1
			;;
	esac
}

get_usecase_requirements() {
	usecase_name="$1"

	case "$usecase_name" in
		mswebapp)
			printf '%s\n' "can2udp" "mswebapp" "can2lan" "clone-ms2-loco"
			;;
		railcontrol)
			printf '%s\n' "can2udp" "railcontrol" "can2lan" "clone-ms2-loco"
			;;
		z21interface)
			printf '%s\n' "can2udp" "z21emu" "can2lan"
			;;
		cs2interface)
			printf '%s\n' "can2udp" "can2lan"
			;;
		itrain)
			printf '%s\n' "can2udp" "can2lan"
			;;
		windigipet)
			printf '%s\n' "can2udp" "can2lan"
			;;
		rocrail)
			printf '%s\n' "can2udp" "rocrail" "can2lan"
			;;
		*)
			echo "Unknown use case: $usecase_name" >&2
			return 1
			;;
	esac
}

verify_usecase_ready() {
	usecase_name="$1"

	for package_name in $(get_usecase_pkgs "$usecase_name"); do
		if pkg_is_installed "$package_name"; then
			echo "Verified ready package: $package_name"
			continue
		fi

		echo "Use case readiness check failed: package $package_name is not installed." >&2
		return 1
	done

	for service_name in $(get_usecase_services "$usecase_name"); do
		if service_is_running "$service_name"; then
			echo "Verified ready service: $service_name"
			continue
		fi

		echo "Use case readiness check failed: service $service_name is not running." >&2
		return 1
	done

	for service_name in $(get_usecase_forbidden_services "$usecase_name"); do
		if service_is_running "$service_name"; then
			echo "Use case readiness check failed: service $service_name must not be running." >&2
			return 1
		fi
		echo "Verified stopped service: $service_name"
	done

	return 0
}

setup_usecase() {
	usecase_name="$1"

	case "$usecase_name" in
		mswebapp|railcontrol|z21interface|cs2interface|itrain|windigipet|rocrail)
			pkgs="$(get_usecase_pkgs "$usecase_name")"
			services="$(get_usecase_services "$usecase_name")"
			;;
		all)
			for entry in mswebapp railcontrol z21interface cs2interface itrain windigipet rocrail; do
				setup_usecase "$entry" || return 1
			done
			return 0
			;;
		*)
			echo "Unknown use case: $usecase_name" >&2
			usage >&2
			return 1
			;;
	esac

	for package_name in $pkgs; do
		install_package "$package_name" || return 1
	done

	for service_name in $(get_usecase_forbidden_services "$usecase_name"); do
		ensure_service_stopped "$service_name" || true
	done

	for service_name in $services; do
		ensure_service_started "$service_name" || true
	done

	verify_usecase_ready "$usecase_name" || return 1

	echo "Use case setup complete: $usecase_name"
	return 0
}

if [ "${SRSEII_SETUP_USECASE_SOURCED:-0}" = "1" ]; then
	return 0 2>/dev/null || exit 0
fi

if [ "$#" -lt 1 ]; then
	usage >&2
	exit 1
fi

if ! command -v opkg >/dev/null 2>&1; then
	echo "OpenWrt package manager (opkg) is not available in this environment." >&2
	exit 1
fi

status_summary=""
for target in "$@"; do
	if [ -n "$status_summary" ]; then
		status_summary="$status_summary,"
	fi
	status_summary="${status_summary}{\"usecase\":\"$(json_escape "$target")\",\"status\":\"pending\"}"
	done

final_rc=0
for target in "$@"; do
	if ! setup_usecase "$target"; then
		final_rc=1
	fi
done

printf '{"targets":[%s],"ok":%s}\n' "$status_summary" "$( [ "$final_rc" -eq 0 ] && printf true || printf false )"

exit "$final_rc"
