#!/bin/sh

# CGI endpoint for WLAN assistant actions:
# - scan
# - connect
# - test

set -eu

activity_log="/usr/sbin/srseii-portal-activity-log"
if [ ! -r "$activity_log" ]; then
	activity_log="$(dirname "$0")/../../../../src/usr/sbin/srseii-portal-activity-log"
fi
. "$activity_log"

SRSEII_ACTIVITY_ACTION=""

CLIENT_PREFIX="srseii_sta_"

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_error() {
	message="$1"
	srseii_activity_finish failure
	printf '{"ok":false,"message":"%s"}\n' "$(json_escape "$message")"
	exit 0
}

json_ok_message() {
	message="$1"
	srseii_activity_finish success
	printf '{"ok":true,"message":"%s"}\n' "$(json_escape "$message")"
	exit 0
}

url_decode() {
	encoded="$1"
	replaced="$(printf '%s' "$encoded" | sed 's/+/ /g; s/%/\\x/g')"
	printf '%b' "$replaced"
}

read_post_body() {
	if [ "${REQUEST_METHOD:-GET}" != "POST" ]; then
		printf ''
		return
	fi

	length="${CONTENT_LENGTH:-0}"
	case "$length" in
		''|*[!0-9]*)
			length=0
			;;
	esac

	if [ "$length" -le 0 ]; then
		printf ''
		return
	fi

	dd bs=1 count="$length" 2>/dev/null || true
}

get_kv_param() {
	source_string="$1"
	key="$2"

	if [ -z "$source_string" ]; then
		printf ''
		return
	fi

	value_enc="$(printf '%s' "$source_string" | tr '&' '\n' | sed -n "s/^$key=//p" | head -n 1)"
	if [ -z "$value_enc" ]; then
		printf ''
		return
	fi

	url_decode "$value_enc"
}

get_wifi_iface() {
	iface=""
	if command -v iw >/dev/null 2>&1; then
		iface="$(iw dev 2>/dev/null | awk '/^[[:space:]]*Interface / {print $2; exit}')"
	fi

	if [ -z "$iface" ]; then
		iface="wlan0"
	fi

	printf '%s' "$iface"
}

ssid_key() {
	ssid_raw="$1"
	if command -v cksum >/dev/null 2>&1; then
		printf '%s' "$ssid_raw" | cksum | awk '{print $1}'
		return
	fi

	# Fallback if cksum is missing.
	printf '%s' "$ssid_raw" | sed 's/[^A-Za-z0-9]/_/g' | tr 'A-Z' 'a-z' | cut -c1-24
}

ensure_client_section_for_ssid() {
	target_ssid="$1"
	section_id="$(ssid_key "$target_ssid")"
	[ -n "$section_id" ] || section_id="manual"
	section_name="${CLIENT_PREFIX}${section_id}"

	if ! uci -q get wireless."$section_name" >/dev/null 2>&1; then
		uci set wireless."$section_name"='wifi-iface'
	fi

	uci set wireless."$section_name".srseii_managed='1'
	uci set wireless."$section_name".srseii_profile_id="$section_id"
	printf '%s' "$section_name"
}

disable_other_managed_sta_profiles() {
	active_section="$1"

	for section in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		if [ "$section" = "$active_section" ]; then
			continue
		fi

		managed_value="$(uci -q get wireless."$section".srseii_managed 2>/dev/null || true)"
		mode_value="$(uci -q get wireless."$section".mode 2>/dev/null || true)"

		if [ "$managed_value" = "1" ] && [ "$mode_value" = "sta" ]; then
			uci set wireless."$section".disabled='1'
		fi
	done
}

disable_other_sta_on_same_device() {
	active_section="$1"
	active_device="$2"

	for section in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		if [ "$section" = "$active_section" ]; then
			continue
		fi

		mode_value="$(uci -q get wireless."$section".mode 2>/dev/null || true)"
		device_value="$(uci -q get wireless."$section".device 2>/dev/null || true)"

		if [ "$mode_value" = "sta" ] && [ "$device_value" = "$active_device" ]; then
			uci set wireless."$section".disabled='1'
		fi
	done
}

scan_networks() {
	scan_file="/tmp/srseii-scan.$$.tsv"
	: >"$scan_file"
	trap 'rm -f "$scan_file"' EXIT INT TERM

	interfaces=""
	if command -v iw >/dev/null 2>&1; then
		interfaces="$(iw dev 2>/dev/null | awk '/^[[:space:]]*Interface / {print $2}' || true)"
	fi

	# Only (re)initialize the wireless stack if no interface exists yet
	# (factory-like state). Calling "wifi up" while an interface is already
	# associated bounces the radio (deauth + reassociate), which drops the
	# very WLAN link a browser may be using to reach this CGI, causing
	# "NetworkError" in the browser even though the scan itself would work.
	if [ -z "$interfaces" ] && command -v wifi >/dev/null 2>&1; then
		wifi up >/dev/null 2>&1 || true
		interfaces="$(iw dev 2>/dev/null | awk '/^[[:space:]]*Interface / {print $2}' || true)"
	fi

	if [ -z "$interfaces" ] && command -v iwinfo >/dev/null 2>&1; then
		interfaces="$(iwinfo 2>/dev/null | awk '/^[^[:space:]][^[:space:]]*[[:space:]]+ESSID:/ {print $1}' | sed 's/[[:space:]]*$//' | sed '/^$/d' || true)"
	fi

	if [ -z "$interfaces" ]; then
		interfaces="$(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p' || true)"
	fi

	if [ -z "$interfaces" ]; then
		interfaces="$(get_wifi_iface)"
	fi

	for iface in $interfaces; do
		if command -v iwinfo >/dev/null 2>&1; then
			scan_output="$(iwinfo "$iface" scan 2>/dev/null || true)"
			if [ -n "$scan_output" ] && printf '%s' "$scan_output" | grep -q 'ESSID:'; then
				printf '%s' "$scan_output" | awk '
				function emit() {
					if (ssid == "") return
					if (enc == "") enc = "unknown"
					if (sig == "") sig = 0
					if (qual == "") qual = 0
					printf "%s\t%s\t%s\t%s\n", ssid, enc, sig, qual
				}
				BEGIN { ssid = ""; enc = ""; sig = ""; qual = "" }
				/^Cell / { emit(); ssid = ""; enc = ""; sig = ""; qual = "" }
				/ESSID:/ {
					ssid = $0
					sub(/^.*ESSID:[[:space:]]*"?/, "", ssid)
					sub(/"?[[:space:]]*$/, "", ssid)
					gsub(/^[[:space:]]+/, "", ssid)
				}
				/Signal:/ {
					signal_line = $0
					if (match(signal_line, /Signal:[[:space:]]*(-?[0-9]+)(\.[0-9]+)?/, m)) {
						sig = m[1]
					}
				}
				/Quality:/ {
					quality_line = $0
					if (match(quality_line, /Quality:[[:space:]]*([0-9]+)\/[[:space:]]*([0-9]+)/, q)) {
						if (q[2] > 0) qual = int((q[1] * 100) / q[2])
					}
				}
				$1 == "Encryption:" {
					enc = substr($0, index($0, $2))
				}
				END { emit() }
				' >>"$scan_file"
			fi
		fi

		if command -v iw >/dev/null 2>&1; then
			scan_output="$(iw dev "$iface" scan 2>/dev/null || true)"
			if [ -n "$scan_output" ] && printf '%s' "$scan_output" | grep -q 'SSID:'; then
				printf '%s' "$scan_output" | awk '
				/SSID: / {
					ssid = $0
					sub(/^[[:space:]]*SSID:[[:space:]]*/, "", ssid)
					if (ssid != "") {
						printf "%s\t%s\t%s\t%s\n", ssid, "unknown", 0, 0
					}
				}
				' >>"$scan_file"
			fi
		fi
	done

	if [ -s "$scan_file" ]; then
		scan_json="$(awk -F '\t' '
		function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
		{
			ssid = $1
			sec = $2
			sig = $3 + 0
			qual = $4 + 0
			if (ssid == "") next
			if (!(ssid in keep) || qual > keepQual[ssid]) {
				keep[ssid] = sec
				keepSig[ssid] = sig
				keepQual[ssid] = qual
			}
		}
		END {
			printf "["
			first = 1
			for (s in keep) {
				if (!first) printf ","
				first = 0
				printf "{\"ssid\":\"%s\",\"security\":\"%s\",\"signal\":%d,\"quality\":%d}", esc(s), esc(keep[s]), keepSig[s], keepQual[s]
			}
			printf "]"
		}
		' "$scan_file")"
		srseii_activity_finish success
		printf '{"ok":true,"networks":%s,"message":"scan complete"}\n' "$scan_json"
		exit 0
	fi

	iface_list="$(printf '%s' "$interfaces" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
	[ -n "$iface_list" ] || iface_list="none"
	json_error "No WLAN networks found. Checked interfaces: $iface_list"
}

wireless_connected_and_ip() {
	iface="$(get_wifi_iface)"
	connected=false
	ip_addr=""

	if command -v iw >/dev/null 2>&1; then
		if iw dev "$iface" link 2>/dev/null | grep -q 'Connected to'; then
			connected=true
		fi
	fi

	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		wwan_json="$(ubus call network.interface.wwan status 2>/dev/null || true)"
		if [ -n "$wwan_json" ]; then
			ip_addr="$(printf '%s' "$wwan_json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || true)"
		fi
	fi

	if [ -z "$ip_addr" ]; then
		ip_addr="$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1 || true)"
	fi

	if [ "$connected" = true ] && [ -n "$ip_addr" ]; then
		return 0
	fi

	return 1
}

connect_network() {
	form_data="$1"
	ssid="$(get_kv_param "$form_data" "ssid")"
	password="$(get_kv_param "$form_data" "password")"
	security="$(get_kv_param "$form_data" "security")"

	if [ -z "$ssid" ]; then
		json_error "SSID is required."
	fi

	sta_section="$(ensure_client_section_for_ssid "$ssid")"

	radio_section="$(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p' | head -n 1 || true)"
	if [ -z "$radio_section" ]; then
		json_error "No wifi device section found in /etc/config/wireless."
	fi

	uci set wireless."$sta_section".device="$radio_section"
	uci set wireless."$sta_section".mode='sta'
	uci set wireless."$sta_section".network='wwan'
	uci set wireless."$sta_section".ssid="$ssid"
	uci set wireless."$sta_section".disabled='0'
	uci set wireless."$sta_section".srseii_managed='1'
	uci set wireless."$radio_section".disabled='0'
	disable_other_managed_sta_profiles "$sta_section"
	disable_other_sta_on_same_device "$sta_section" "$radio_section"

	case "$security" in
		""|auto)
			if [ -n "$password" ]; then
				uci set wireless."$sta_section".encryption='psk2'
				uci set wireless."$sta_section".key="$password"
			else
				uci set wireless."$sta_section".encryption='none'
				uci -q delete wireless."$sta_section".key || true
			fi
			;;
		none|open)
			uci set wireless."$sta_section".encryption='none'
			uci -q delete wireless."$sta_section".key || true
			;;
		psk2|wpa2)
			if [ -z "$password" ]; then
				json_error "Password is required for WPA2."
			fi
			uci set wireless."$sta_section".encryption='psk2'
			uci set wireless."$sta_section".key="$password"
			;;
		psk-mixed|mixed)
			if [ -z "$password" ]; then
				json_error "Password is required for mixed WPA mode."
			fi
			uci set wireless."$sta_section".encryption='psk-mixed'
			uci set wireless."$sta_section".key="$password"
			;;
		sae|wpa3)
			if [ -z "$password" ]; then
				json_error "Password is required for WPA3."
			fi
			uci set wireless."$sta_section".encryption='sae'
			uci set wireless."$sta_section".key="$password"
			;;
		*)
			json_error "Invalid security mode. Use auto, none, psk2, psk-mixed or sae."
			;;
	esac

	if ! uci -q get network.wwan >/dev/null 2>&1; then
		uci set network.wwan='interface'
	fi
	uci set network.wwan.proto='dhcp'

	uci commit wireless
	uci commit network

	written_mode="$(uci -q get wireless."$sta_section".mode 2>/dev/null || true)"
	written_ssid="$(uci -q get wireless."$sta_section".ssid 2>/dev/null || true)"
	written_network="$(uci -q get wireless."$sta_section".network 2>/dev/null || true)"
	written_disabled="$(uci -q get wireless."$sta_section".disabled 2>/dev/null || true)"
	radio_disabled="$(uci -q get wireless."$radio_section".disabled 2>/dev/null || true)"

	if [ "$written_mode" != "sta" ] || [ "$written_ssid" != "$ssid" ] || [ "$written_network" != "wwan" ] || [ "$written_disabled" != "0" ] || [ "$radio_disabled" != "0" ]; then
		json_error "Configuration write verification failed for section $sta_section."
	fi

	if command -v wifi >/dev/null 2>&1; then
		wifi reload >/dev/null 2>&1 || true
		wifi up >/dev/null 2>&1 || true
	fi
	/etc/init.d/network reload >/dev/null 2>&1 || true

	srseii_activity_finish success
	printf '{"ok":true,"message":"Configuration applied in section %s for SSID %s. Run connection test.","requiresTest":true,"section":"%s","ssid":"%s"}\n' "$(json_escape "$sta_section")" "$(json_escape "$ssid")" "$(json_escape "$sta_section")" "$(json_escape "$ssid")"
	exit 0
}

test_connection() {
	if wireless_connected_and_ip; then
		json_ok_message "WLAN connection successful."
	fi

	json_error "Connection test failed."
}

query_action="$(get_kv_param "${QUERY_STRING:-}" "action")"
post_data="$(read_post_body)"
post_action="$(get_kv_param "$post_data" "action")"
action="$query_action"
if [ -n "$post_action" ]; then
	action="$post_action"
fi

case "$action" in
	scan) SRSEII_ACTIVITY_ACTION="Wi-Fi network scan" ;;
	connect) SRSEII_ACTIVITY_ACTION="Wi-Fi configuration" ;;
	test) SRSEII_ACTIVITY_ACTION="Wi-Fi connection test" ;;
esac

case "$action" in
	scan)
		scan_networks
		;;
	connect)
		connect_network "$post_data"
		;;
	test)
		test_connection
		;;
	*)
		json_error "Unknown action. Use scan, connect or test."
		;;
esac
