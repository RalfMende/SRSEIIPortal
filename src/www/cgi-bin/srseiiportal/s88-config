#!/bin/sh
# Reads the configuration of the integrated SRSEII S88 gateway from the CAN bus.
# Request-scoped: runs only when the portal triggers it, listens for a bounded
# time window and exits. No daemon, no polling. Read-only (no CAN writes).

set -u

CAN_IF="can0"
LISTEN_SECONDS=2
# Allowlisted config channels (UID is intentionally excluded: channel mapping unverified).
CHANNELS="01 03 04 07 08"
LOCK_DIR="/tmp/srseii-s88-config.lock"
finished=0

json_escape() {
	printf '%s' "$1" | tr '\r\n' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

fail() {
	finished=1
	printf 'Content-Type: application/json\n'
	printf 'Cache-Control: no-store\n'
	printf '\n'
	printf '{"ok":false,"message":"%s","messageDe":"%s"}\n' \
		"$(json_escape "$1")" "$(json_escape "$2")"
	exit 0
}

if [ "${REQUEST_METHOD:-GET}" != "POST" ]; then
	fail "Only POST requests are supported." "Es werden nur POST-Anfragen unterstützt."
fi

command -v cansend >/dev/null 2>&1 && command -v candump >/dev/null 2>&1 ||
	fail "can-utils (cansend/candump) are not installed." "can-utils (cansend/candump) sind nicht installiert."

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
	fail "Another S88 read is already running." "Ein S88-Auslesevorgang läuft bereits."
fi

dump_file="$(mktemp /tmp/srseii-s88-dump.XXXXXX)" ||
	fail "Cannot create a temporary file." "Temporäre Datei kann nicht angelegt werden."
err_file="$dump_file.err"
cleanup() {
	[ -n "${dump_pid:-}" ] && kill "$dump_pid" 2>/dev/null || true
	rm -f "$dump_file" "$err_file"
	rmdir "$LOCK_DIR" 2>/dev/null || true
	if [ "$finished" -eq 0 ]; then
		fail "The S88 read ended unexpectedly." "Das Auslesen wurde unerwartet beendet."
	fi
}
trap cleanup EXIT
trap 'exit 0' INT TERM

# 1. Start the listener first so that no reply is missed.
# Line-buffer the output where possible: a SIGTERM must not discard buffered frames.
if command -v stdbuf >/dev/null 2>&1; then
	stdbuf -oL candump -L "$CAN_IF" >"$dump_file" 2>"$err_file" &
else
	candump -L "$CAN_IF" >"$dump_file" 2>"$err_file" &
fi
dump_pid=$!
sleep 1
kill -0 "$dump_pid" 2>/dev/null || fail "candump could not listen on $CAN_IF (is the interface up?)." "candump kann $CAN_IF nicht abhören (ist die Schnittstelle aktiv?)."

# 2. Request each config channel; the gateway answers on the CAN bus.
send_failed=0
for channel in $CHANNELS; do
	cansend "$CAN_IF" "00000300#434255530B${channel}" >/dev/null 2>&1 || send_failed=1
done
[ "$send_failed" -eq 0 ] || fail "Sending the CAN requests failed (is $CAN_IF up?)." "Senden der CAN-Anfragen fehlgeschlagen (ist $CAN_IF aktiv?)."

# 3. Collect replies for a bounded time, then stop the listener (SIGTERM flushes its output).
sleep "$LISTEN_SECONDS"
kill "$dump_pid" 2>/dev/null || true
wait "$dump_pid" 2>/dev/null || true
dump_pid=""

# Parse "candump -L" lines "(timestamp) can0 ID#DATA" in plain POSIX shell
# (busybox awk is not reliable here). A reply is "CBUS 0B <channel> <value>";
# our own 6-byte requests (no value) are echoed by loopback and are skipped.
channels_json=""
seen_channels=" "
while read -r _ts _if frame _rest; do
	case "$frame" in
	*#*) ;;
	*) continue ;;
	esac
	can_id="${frame%%#*}"
	data="$(printf '%s' "${frame#*#}" | tr 'a-f' 'A-F')"
	case "$data" in
	434255530B??*) ;;
	*) continue ;;
	esac
	rest="${data#434255530B}"
	channel="$(printf '%s' "$rest" | cut -c1-2)"
	value="${rest#??}"
	[ -n "$value" ] || continue
	case "$value" in
	*[!0-9A-F]*) continue ;;
	esac
	[ $(( ${#value} % 2 )) -eq 0 ] || continue
	case " $CHANNELS " in
	*" $channel "*) ;;
	*) continue ;;
	esac
	case "$seen_channels" in
	*" $channel "*) continue ;;
	esac
	seen_channels="$seen_channels$channel "
	can_id="$(printf '%s' "$can_id" | tr 'a-f' 'A-F')"
	entry="\"$channel\":{\"value\":\"$value\",\"id\":\"$can_id\",\"frame\":\"$can_id#$data\"}"
	if [ -z "$channels_json" ]; then
		channels_json="$entry"
	else
		channels_json="$channels_json,$entry"
	fi
done <"$dump_file"

if [ -z "$channels_json" ]; then
	seen_lines="$(wc -l <"$dump_file" 2>/dev/null | tr -d ' ')"
	sample="$(head -n 3 "$dump_file" 2>/dev/null | tr '\n' '|')$(head -c 120 "$err_file" 2>/dev/null)"
	fail "No S88 reply within ${LISTEN_SECONDS}s (captured frames: ${seen_lines:-0}; sample: ${sample})." "Keine S88-Antwort innerhalb von ${LISTEN_SECONDS} s (erfasste Frames: ${seen_lines:-0}; Beispiel: ${sample})."
fi

printf 'Content-Type: application/json\n'
printf 'Cache-Control: no-store\n'
printf '\n'
finished=1
printf '{"ok":true,"channels":{%s}}\n' "$channels_json"
